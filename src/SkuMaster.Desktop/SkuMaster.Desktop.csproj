<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <StartupObject>SkuMaster.Desktop.Program</StartupObject>
    <AssemblyName>SkuMaster</AssemblyName>
    <Product>SKU Майстер</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/app.ico" />
    <ProjectReference Include="../SkuMaster.Infrastructure/SkuMaster.Infrastructure.csproj" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>
</Project>
