<Window x:Class="SkuMaster.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SkuMaster.Desktop"
 Title="SKU Майстер" Style="{StaticResource {x:Type Window}}" Width="1200" Height="860" MinWidth="920" MinHeight="700" WindowStartupLocation="CenterScreen"
 Closing="Window_Closing" Loaded="Window_Loaded">
 <Grid Margin="28,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="SKU Майстер" FontSize="29" FontWeight="Bold"/><TextBlock Text="Наявність товарів під контролем" Foreground="#61756D" Margin="0,4,0,0"/></StackPanel>
   <Border Grid.Column="1" Background="#E3EDE5" CornerRadius="18" Padding="15,8" VerticalAlignment="Center"><TextBlock Text="●  Файли обробляються на вашому комп’ютері" Foreground="#126A55" FontSize="12"/></Border>
  </Grid>
  <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
   <TabItem Header="1  Файли">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,18,0,8" IsEnabled="{Binding CanEdit}">
      <TextBlock Text="Оберіть джерела даних" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="SKU вважається наявним, якщо його знайдено хоча б в одному джерелі — 1С або у постачальника." Style="{StaticResource Hint}" Margin="0,6,0,16"/>
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
       <StackPanel><TextBlock Text="А · Експорт із сайту" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="CSV з колонками SKU та статусу. Саме цей список буде оновлено." Style="{StaticResource Hint}" Margin="0,5,0,12"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="Обрати CSV…" Tag="site" Click="Browse_Click" Margin="12,0,0,0"/><TextBox Text="{Binding SitePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Шлях до експорту сайту" ToolTip="{Binding SitePath}"/></DockPanel>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,12">
       <StackPanel><TextBlock Text="Б · Експорт із 1С" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="Excel (.xlsx або .xls). SKU у першій колонці." Style="{StaticResource Hint}" Margin="0,5,0,12"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="Обрати Excel…" Tag="onec" Click="Browse_Click" Margin="12,0,0,0"/><TextBox Text="{Binding OneCPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Шлях до експорту із 1С" ToolTip="{Binding OneCPath}"/></DockPanel>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox Content="Перший рядок містить заголовки" IsChecked="{Binding Settings.OneC.HasHeader}" Checked="Settings_Changed" Unchecked="Settings_Changed"/><ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding OneCSheets}" Text="{Binding Settings.OneC.SheetName, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Аркуш 1С" ToolTip="Аркуш. Порожнє значення — перший аркуш."/></Grid>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
       <StackPanel><TextBlock Text="В · Файл постачальника" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="Excel (.xlsx або .xls). SKU у першій колонці." Style="{StaticResource Hint}" Margin="0,5,0,12"/>
        <DockPanel><Button DockPanel.Dock="Right" Content="Обрати Excel…" Tag="supplier" Click="Browse_Click" Margin="12,0,0,0"/><TextBox Text="{Binding SupplierPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Шлях до файлу постачальника" ToolTip="{Binding SupplierPath}"/></DockPanel>
        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox Content="Перший рядок містить заголовки" IsChecked="{Binding Settings.Supplier.HasHeader}" Checked="Settings_Changed" Unchecked="Settings_Changed"/><ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding SupplierSheets}" Text="{Binding Settings.Supplier.SheetName, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Аркуш постачальника" ToolTip="Аркуш. Порожнє значення — перший аркуш."/></Grid>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="2  Налаштування">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel x:Name="SettingsPanel" Margin="0,18,0,8" IsEnabled="{Binding CanEdit}">
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
       <StackPanel><TextBlock Text="Правила обробки" FontSize="20" FontWeight="SemiBold"/>
        <ComboBox ItemsSource="{Binding Operations}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding Settings.OperationId}" Margin="0,12,0,0" SelectionChanged="Settings_Changed" AutomationProperties.Name="Операція"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Якщо SKU немає в обох джерелах" Style="{StaticResource Label}"/><TextBox Text="{Binding Settings.Rules.UnavailableStatus, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Статус відсутнього товару"/><TextBlock Text="Цей статус буде встановлено для відсутніх товарів." Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Якщо SKU є: замінювати лише цей статус" Style="{StaticResource Label}"/><TextBox Text="{Binding Settings.Rules.MatchStatus, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Статус для заміни"/><TextBlock Text="Інші статуси наявних товарів залишаться без змін." Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
        </Grid>
        <CheckBox Content="Очищувати статус знайдених товарів" IsChecked="{Binding Settings.Rules.ClearFoundStatus}" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,16,0,8"/>
        <TextBlock Text="Або замінювати на (вимкніть очищення вище)" Style="{StaticResource Label}"/><TextBox Text="{Binding Settings.Rules.ReplacementStatus, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Новий статус знайденого товару"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
       <StackPanel><TextBlock Text="Експорт сайту: як читати CSV" FontSize="20" FontWeight="SemiBold"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Колонка SKU" Style="{StaticResource Label}"/><ComboBox IsEditable="True" ItemsSource="{Binding SiteColumns}" Text="{Binding Settings.Rules.SkuColumn, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Колонка SKU" SelectionChanged="Settings_Changed"/><TextBlock Text="Роздільник" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static local:MainViewModel.InputDelimiters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.CsvInput.Delimiter}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Вхідний роздільник"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Колонка статусу" Style="{StaticResource Label}"/><ComboBox IsEditable="True" ItemsSource="{Binding SiteColumns}" Text="{Binding Settings.Rules.StatusColumn, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Колонка статусу" SelectionChanged="Settings_Changed"/><TextBlock Text="Кодування" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static local:MainViewModel.InputEncodings}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.CsvInput.EncodingName}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Вхідне кодування"/></StackPanel>
        </Grid>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
       <StackPanel><TextBlock Text="Файл результату" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Формат" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static local:MainViewModel.Formats}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Export.Format}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Формат результату"/>
        <CheckBox Content="Додати рядок заголовків" IsChecked="{Binding Settings.Export.IncludeHeaders}" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Заголовок SKU" Style="{StaticResource Label}"/><TextBox Text="{Binding Settings.Export.SkuHeader, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Вихідний заголовок SKU"/><TextBlock Text="Роздільник CSV" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static local:MainViewModel.OutputDelimiters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Export.Delimiter}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Вихідний роздільник"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Заголовок статусу" Style="{StaticResource Label}"/><TextBox Text="{Binding Settings.Export.StatusHeader, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Вихідний заголовок статусу"/><TextBlock Text="Кодування CSV" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static local:MainViewModel.OutputEncodings}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Export.EncodingName}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Вихідне кодування"/></StackPanel>
        </Grid>
        <TextBlock Text="Місце збереження ви оберете після перевірки. Додаткові колонки сайту збережуться." Style="{StaticResource Hint}" Margin="0,16,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="3  Результат">
    <Grid Margin="0,18,0,8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Результат перевірки" FontSize="22" FontWeight="SemiBold"/>
     <UniformGrid Grid.Row="1" Columns="5" Margin="0,15,0,16">
      <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14"><StackPanel><TextBlock Text="Перевірено" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Summary.Total, TargetNullValue=—, StringFormat=N0}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="рядків сайту" Style="{StaticResource Hint}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14"><StackPanel><TextBlock Text="Стали недоступними" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Summary.Unavailable, TargetNullValue=—, StringFormat=N0}" FontSize="28" Foreground="#A26519" FontWeight="SemiBold"/><TextBlock Text="статус буде змінено" Style="{StaticResource Hint}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14"><StackPanel><TextBlock Text="Знову доступні" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Summary.Available, TargetNullValue=—, StringFormat=N0}" FontSize="28" Foreground="#126A55" FontWeight="SemiBold"/><TextBlock Text="знайдено у джерелах" Style="{StaticResource Hint}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14"><StackPanel><TextBlock Text="Усього змін статусу" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Summary.Changed, TargetNullValue=—, StringFormat=N0}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="фактичні зміни" Style="{StaticResource Hint}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="14"><StackPanel><TextBlock Text="Без змін" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Summary.Unchanged, TargetNullValue=—, StringFormat=N0}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="статуси збережено" Style="{StaticResource Hint}"/></StackPanel></Border>
     </UniformGrid>
     <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,10"><ComboBox DockPanel.Dock="Right" Width="215" SelectedIndex="{Binding Filter}" AutomationProperties.Name="Фільтр змін"><ComboBoxItem Content="Усі зміни"/><ComboBoxItem Content="Стали недоступними"/><ComboBoxItem Content="Знову доступні"/></ComboBox><TextBlock Text="{Binding Summary.UniqueSkus, StringFormat=Унікальних SKU: {0:N0}, TargetNullValue=Спочатку перевірте файли}" VerticalAlignment="Center" Foreground="#61756D"/></DockPanel>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Changes}" AutomationProperties.Name="Зміни статусів"><DataGrid.Columns><DataGridTextColumn Header="Рядок" Binding="{Binding RowNumber}" Width="65"/><DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="*"/><DataGridTextColumn Header="Поточний статус" Binding="{Binding DisplayOldStatus}" Width="1.3*"/><DataGridTextColumn Header="Новий статус" Binding="{Binding DisplayNewStatus}" Width="1.3*"/><DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="1.7*"/></DataGrid.Columns></DataGrid>
     </Grid>
     <Expander Grid.Row="3" Header="{Binding WarningCount}" HeaderStringFormat="Попередження ({0})" Margin="0,12,0,0"><ListBox ItemsSource="{Binding Warnings}" MaxHeight="135" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="4"/></DataTemplate></ListBox.ItemTemplate></ListBox></Expander>
    </Grid>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" BorderBrush="#D6E1D8" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,10,0,0">
   <StackPanel>
    <ProgressBar IsIndeterminate="True" Height="3" Foreground="{StaticResource Accent}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10"/>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="60" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" Foreground="#61756D" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="UpdateButton" Content="Оновлення" Click="Update_Click" Padding="12,7"/><TextBlock x:Name="UpdateLabel" Foreground="#61756D" FontSize="11" MaxWidth="240" TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Скасувати" Click="Cancel_Click" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,10,0"/><Button Content="Перевірити файли" Click="Analyze_Click" IsEnabled="{Binding CanAnalyze}" Margin="0,0,10,0"/><Button Content="Зберегти результат…" Click="Save_Click" IsEnabled="{Binding CanSave}" Style="{StaticResource PrimaryButton}"/></StackPanel>
    </Grid>
   </StackPanel>
  </Border>
 </Grid>
</Window>
