<Window x:Class="SkuMaster.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SkuMaster.Desktop"
 Title="SKU Майстер" Icon="Assets/app.ico" Style="{StaticResource {x:Type Window}}" Width="980" Height="640" MinWidth="840" MinHeight="580" WindowStartupLocation="CenterScreen"
 Closing="Window_Closing" Loaded="Window_Loaded">
 <Grid Margin="18,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="SKU Майстер" FontSize="24" FontWeight="Bold"/><TextBlock Text="Наявність товарів під контролем" Foreground="#61756D" Margin="0,4,0,0"/></StackPanel>
   <ComboBox x:Name="ModuleSelector" Grid.Column="1" Width="300" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="Module_Changed" AutomationProperties.Name="Модуль програми"><ComboBoxItem Content="Оновлення статусів"/><ComboBoxItem Content="Товари, яких немає на сайті"/></ComboBox>
  </Grid>
  <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
   <TabItem Header="1  Файли">
    <Grid x:Name="FilesPanel" Margin="0,12,0,0" IsEnabled="{Binding CanEdit}" TextElement.FontWeight="Normal">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Оберіть три файли. SKU наявний, якщо є в 1С або у постачальника." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
     <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="А · Експорт із сайту" FontWeight="SemiBold"/><TextBlock Text="CSV · 1: SKU, 2: статус" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel>
       <TextBox Grid.Column="1" Text="{Binding SitePath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.Name="Шлях до експорту сайту" ToolTip="{Binding SitePath}"/>
       <Button Grid.Column="2" Content="Обрати…" Tag="site" Click="Browse_Click" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="Б · Експорт із 1С" FontWeight="SemiBold"/><TextBlock Text="Excel · SKU в колонці 1" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel>
       <TextBox Grid.Column="1" Text="{Binding OneCPath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.Name="Шлях до експорту із 1С" ToolTip="{Binding OneCPath}"/>
       <Button Grid.Column="2" Content="Обрати…" Tag="onec" Click="Browse_Click" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,8">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center"><TextBlock Text="В · Постачальник" FontWeight="SemiBold"/><TextBlock Text="Excel · SKU в колонці 1" Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel>
       <TextBox Grid.Column="1" Text="{Binding SupplierPath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.Name="Шлях до файлу постачальника" ToolTip="{Binding SupplierPath}"/>
       <Button Grid.Column="2" Content="Обрати…" Tag="supplier" Click="Browse_Click" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </Grid>
     </Border>
    </Grid>
   </TabItem>
   <TabItem Header="2  Налаштування">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel x:Name="SettingsPanel" TextElement.FontWeight="Normal" Margin="0,12,0,8" IsEnabled="{Binding CanEdit}">
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
       <StackPanel><TextBlock Text="Правила обробки" FontSize="20" FontWeight="SemiBold"/>
        <ComboBox ItemsSource="{Binding Operations}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding Settings.OperationId}" Margin="0,12,0,0" SelectionChanged="Settings_Changed" AutomationProperties.Name="Операція"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Якщо SKU немає в обох джерелах" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static local:MainViewModel.NonEmptyStatusChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Rules.UnavailableStatus}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Статус відсутнього товару"/><TextBlock Text="Цей статус буде встановлено для відсутніх товарів." Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Якщо SKU є: замінювати лише цей статус" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static local:MainViewModel.StatusChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Rules.MatchStatus}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Статус для заміни"/><TextBlock Text="Інші статуси наявних товарів залишаться без змін." Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
        </Grid>
        <CheckBox Content="Очищувати статус знайдених товарів" IsChecked="{Binding Settings.Rules.ClearFoundStatus}" Checked="Settings_Changed" Unchecked="Settings_Changed" Margin="0,16,0,8"/>
        <TextBlock Text="Або замінювати на (вимкніть очищення вище)" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static local:MainViewModel.StatusChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Rules.ReplacementStatus}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Новий статус знайденого товару"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
       <StackPanel><TextBlock Text="Експорт сайту: як читати CSV" FontSize="20" FontWeight="SemiBold"/>
        <CheckBox Content="Перший рядок CSV містить заголовки" IsChecked="{Binding Settings.CsvInput.HasHeader}" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
        <TextBlock Text="Без заголовків: колонка 1 — SKU, колонка 2 — статус. Перший товар зберігається." Style="{StaticResource Hint}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Колонка SKU" Style="{StaticResource Label}"/><ComboBox IsEditable="True" IsEnabled="{Binding Settings.CsvInput.HasHeader}" ItemsSource="{Binding SiteColumns}" Text="{Binding Settings.Rules.SkuColumn, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Колонка SKU" SelectionChanged="Settings_Changed"/><TextBlock Text="Роздільник" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static local:MainViewModel.InputDelimiters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.CsvInput.Delimiter}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Вхідний роздільник"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Колонка статусу" Style="{StaticResource Label}"/><ComboBox IsEditable="True" IsEnabled="{Binding Settings.CsvInput.HasHeader}" ItemsSource="{Binding SiteColumns}" Text="{Binding Settings.Rules.StatusColumn, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Колонка статусу" SelectionChanged="Settings_Changed"/><TextBlock Text="Кодування" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static local:MainViewModel.InputEncodings}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.CsvInput.EncodingName}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Вхідне кодування"/></StackPanel>
        </Grid>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,14">
       <StackPanel><TextBlock Text="Джерела Excel" FontSize="20" FontWeight="SemiBold"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0"><TextBlock Text="Б · Експорт із 1С" Style="{StaticResource Label}"/><CheckBox Content="Перший рядок містить заголовки" IsChecked="{Binding Settings.OneC.HasHeader}" Checked="Settings_Changed" Unchecked="Settings_Changed"/><TextBlock Text="Аркуш (порожньо — перший)" Style="{StaticResource Hint}" Margin="0,0,0,5"/><ComboBox IsEditable="True" ItemsSource="{Binding OneCSheets}" Text="{Binding Settings.OneC.SheetName, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Аркуш 1С"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="В · Постачальник" Style="{StaticResource Label}"/><CheckBox Content="Перший рядок містить заголовки" IsChecked="{Binding Settings.Supplier.HasHeader}" Checked="Settings_Changed" Unchecked="Settings_Changed"/><TextBlock Text="Аркуш (порожньо — перший)" Style="{StaticResource Hint}" Margin="0,0,0,5"/><ComboBox IsEditable="True" ItemsSource="{Binding SupplierSheets}" Text="{Binding Settings.Supplier.SheetName, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Аркуш постачальника"/></StackPanel>
        </Grid>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
       <StackPanel><TextBlock Text="Файл результату" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="Формат" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static local:MainViewModel.Formats}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Export.Format}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Формат результату"/>
        <CheckBox Content="Додати рядок заголовків" IsChecked="{Binding Settings.Export.IncludeHeaders}" Checked="Settings_Changed" Unchecked="Settings_Changed"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Заголовок SKU" Style="{StaticResource Label}"/><TextBox Text="{Binding Settings.Export.SkuHeader, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Вихідний заголовок SKU"/><TextBlock Text="Роздільник CSV" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static local:MainViewModel.OutputDelimiters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Export.Delimiter}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Вихідний роздільник"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="Заголовок статусу" Style="{StaticResource Label}"/><TextBox Text="{Binding Settings.Export.StatusHeader, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Вихідний заголовок статусу"/><TextBlock Text="Кодування CSV" Style="{StaticResource Label}"/><ComboBox ItemsSource="{x:Static local:MainViewModel.OutputEncodings}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Export.EncodingName}" SelectionChanged="Settings_Changed" AutomationProperties.Name="Вихідне кодування"/></StackPanel>
        </Grid>
        <TextBlock Text="Місце збереження ви оберете після перевірки. Додаткові колонки сайту збережуться." Style="{StaticResource Hint}" Margin="0,16,0,0"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="3  Результат">
    <Grid Margin="0,10,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Результат перевірки" FontSize="18" FontWeight="SemiBold"/>
     <UniformGrid Grid.Row="1" Columns="5" Margin="0,8,0,8">
      <Button x:Name="SummaryCard3" Style="{StaticResource SummaryButton}" Tag="3" Click="Summary_Click"><StackPanel><TextBlock Text="Перевірено" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Summary.Total, TargetNullValue=—, StringFormat=N0}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="рядків сайту" Style="{StaticResource Hint}"/></StackPanel></Button>
      <Button x:Name="SummaryCard1" Style="{StaticResource SummaryButton}" Tag="1" Click="Summary_Click"><StackPanel><TextBlock Text="Стали недоступними" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Summary.Unavailable, TargetNullValue=—, StringFormat=N0}" FontSize="23" Foreground="#A26519" FontWeight="SemiBold"/><TextBlock Text="статус буде змінено" Style="{StaticResource Hint}"/></StackPanel></Button>
      <Button x:Name="SummaryCard2" Style="{StaticResource SummaryButton}" Tag="2" Click="Summary_Click"><StackPanel><TextBlock Text="Знову доступні" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Summary.Available, TargetNullValue=—, StringFormat=N0}" FontSize="23" Foreground="#126A55" FontWeight="SemiBold"/><TextBlock Text="знайдено у джерелах" Style="{StaticResource Hint}"/></StackPanel></Button>
      <Button x:Name="SummaryCard0" Style="{StaticResource SummaryButton}" Tag="0" Click="Summary_Click"><StackPanel><TextBlock Text="Усього змін статусу" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Summary.Changed, TargetNullValue=—, StringFormat=N0}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="фактичні зміни" Style="{StaticResource Hint}"/></StackPanel></Button>
      <Button x:Name="SummaryCard4" Style="{StaticResource SummaryButton}" Tag="4" Click="Summary_Click"><StackPanel><TextBlock Text="Без змін" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Summary.Unchanged, TargetNullValue=—, StringFormat=N0}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="статуси збережено" Style="{StaticResource Hint}"/></StackPanel></Button>
     </UniformGrid>
     <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid IsEnabled="{Binding HasResult}" TextElement.FontWeight="Normal">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="78"/></Grid.ColumnDefinitions>
       <Grid Margin="0,0,6,0"><TextBox x:Name="ResultSearch" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Пошук SKU або статусу" ToolTip="Пошук за частиною SKU, старого або нового статусу"/>
        <TextBlock Text="Пошук SKU або статусу…" IsHitTestVisible="False" Foreground="#61756D" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ResultSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </Grid>
       <ComboBox Grid.Column="1" Margin="0,0,6,0" SelectedIndex="{Binding Filter}" AutomationProperties.Name="Фільтр змін" ToolTip="Тип зміни"><ComboBoxItem Content="Усі зміни"/><ComboBoxItem Content="Недоступні"/><ComboBoxItem Content="Знову доступні"/><ComboBoxItem Content="Усі товари"/><ComboBoxItem Content="Без змін"/></ComboBox>
       <ComboBox Grid.Column="2" Margin="0,0,6,0" ItemsSource="{Binding OldStatusOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedOldStatus}" AutomationProperties.Name="Фільтр старого статусу" ToolTip="Поточний статус до обробки"/>
       <ComboBox Grid.Column="3" Margin="0,0,6,0" ItemsSource="{Binding NewStatusOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedNewStatus}" AutomationProperties.Name="Фільтр нового статусу" ToolTip="Новий статус після обробки"/>
       <Button Grid.Column="4" Content="Скинути" Click="ResetFilters_Click" Padding="8,6"/>
      </Grid>
      <DockPanel Grid.Row="1" Margin="0,5,0,5"><TextBlock Text="{Binding FilterSummary}" DockPanel.Dock="Right" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Summary.UniqueSkus, StringFormat=Унікальних SKU: {0:N0}, TargetNullValue=Спочатку перевірте файли}" Style="{StaticResource Hint}"/></DockPanel>
      <DataGrid x:Name="ResultsGrid" Grid.Row="2" ItemsSource="{Binding Changes}" AutomationProperties.Name="Зміни статусів"><DataGrid.Columns><DataGridTextColumn Header="Рядок" Binding="{Binding RowNumber}" Width="65"/><DataGridTemplateColumn Header="SKU" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Sku}" Click="CopySku_Click" ToolTip="Натисніть, щоб скопіювати SKU" Padding="4,0" Background="Transparent" BorderBrush="Transparent" Foreground="#126A55" HorizontalAlignment="Left"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Поточний статус" Binding="{Binding DisplayOldStatus}" Width="1.3*"/><DataGridTemplateColumn Header="Новий статус ✎" Width="1.3*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid><ComboBox x:Name="StatusEditor" ItemsSource="{x:Static local:MainViewModel.StatusChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding NewStatus, Mode=OneWay}" MinHeight="0" Padding="4,0" Margin="0" IsEditable="False" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" SelectionChanged="Status_SelectionChanged" DropDownClosed="Status_DropDownClosed" ToolTip="Оберіть статус. «Без статусу» очищує поле."/><TextBlock Text="{Binding NewStatus}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="6,0,24,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=StatusEditor}" Value="-1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="1.7*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Reason}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid>
      <TextBlock Grid.Row="2" Text="{Binding EmptyResultMessage}" Visibility="{Binding NoMatches, Converter={StaticResource BoolVisibility}}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500" Margin="20,34,20,0" Foreground="#61756D" IsHitTestVisible="False"/>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="Як користуватися">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,12,0,8" TextElement.FontWeight="Normal">
      <TextBlock Text="Від трьох файлів до готового результату" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock Text="1. Додайте три файли: експорт сайту, експорт із 1С та файл постачальника." TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="2. Натисніть «Перевірити файли» та перегляньте підсумок." TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="3. Натискайте блоки статистики та фільтри, щоб знайти потрібні товари. Клік по SKU копіює його." TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="4. За потреби змініть «Новий статус» у списку. «Без статусу» очищує поле." TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="5. Залиште галочку «Зберегти лише змінені товари» — вона вже ввімкнена. Щоб зберегти всі товари, зніміть її." TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="6. Натисніть «Зберегти результат…», оберіть папку та ім’я файлу. Готово!" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="Пошук і фільтри впливають лише на перегляд. Початкові файли не змінюються." Style="{StaticResource Hint}"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Попередження">
    <Grid Margin="0,12,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding WarningCount, StringFormat=Попереджень: {0}}" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
     <ListBox x:Name="StatusWarningsList" Grid.Row="1" ItemsSource="{Binding Warnings}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="5"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
   </TabItem>
  </TabControl><ContentControl x:Name="MissingModule" Grid.Row="1" Visibility="Collapsed"/>
  <Border Grid.Row="2" BorderBrush="#D6E1D8" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,10,0,0">
   <StackPanel>
    <ProgressBar x:Name="StatusProgress" IsIndeterminate="True" Height="3" Foreground="{StaticResource Accent}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10"/>
    <DockPanel x:Name="StatusMessage" Margin="0,0,0,10">
     <CheckBox DockPanel.Dock="Right" Content="Зберегти лише змінені товари" IsChecked="{Binding ExportOnlyChanged}" IsEnabled="{Binding CanEdit}" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="Вимкнено — усі товари. Увімкнено — лише рядки, де фактично змінився статус. Пошук і фільтри таблиці на експорт не впливають."/>
     <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxHeight="60" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" Foreground="#61756D" VerticalAlignment="Center" Margin="0,0,12,0"/><Button x:Name="UpdateButton" Content="Оновлення" Click="Update_Click" Padding="12,7"/><TextBlock x:Name="UpdateLabel" Foreground="#61756D" FontSize="11" MaxWidth="150" TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <StackPanel x:Name="StatusActions" Grid.Column="1" Orientation="Horizontal"><Button Content="Скасувати" Click="Cancel_Click" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,10,0"/><Button Content="Перевірити файли" Click="Analyze_Click" IsEnabled="{Binding CanAnalyze}" Margin="0,0,10,0"/><Button Content="Зберегти результат…" Click="Save_Click" IsEnabled="{Binding CanSave}" Style="{StaticResource PrimaryButton}"/></StackPanel>
     <ContentControl x:Name="MissingActions" Grid.Column="1" Visibility="Collapsed"/>
    </Grid>
   </StackPanel>
  </Border>
 </Grid>
</Window>
